{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(go fmt *)",
      "Bash(gofmt *)",
      "Bash(npx expo-doctor)",
      "Bash(npx tsc *)",
      "Bash(app/node_modules/.bin/prettier *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format-file.js",
            "timeout": 30,
            "statusMessage": "Formateando con Prettier..."
          }
        ]
      }
    ]
  }
}
